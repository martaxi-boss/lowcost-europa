[Unit]
Description=Notify search engines of changed public Lowcost Europa pages
After=network-online.target lowcost-europa.service
Wants=network-online.target

[Service]
Type=oneshot
User=le001_1789265592
WorkingDirectory=/srv/projects/lowcost-europa
EnvironmentFile=/srv/projects/lowcost-europa/private/systemd-env/lowcost-europa.env
ExecStart=/srv/projects/lowcost-europa/.venv/bin/python manage.py notify_indexnow
TimeoutStartSec=5min
PrivateTmp=true
NoNewPrivileges=true
UMask=0077
