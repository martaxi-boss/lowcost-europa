DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production HTTPS: short HSTS lifetime by default; never enable preload in staging.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
POSTGRES_DB=lowcost_europa
POSTGRES_USER=lowcost_europa
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
ALIEXPRESS_APP_KEY=replace-with-your-app-key
ALIEXPRESS_APP_SECRET=replace-with-your-app-secret
ALIEXPRESS_TRACKING_ID=lowcost_europa
ALIEXPRESS_GATEWAY=https://api-sg.aliexpress.com/sync
ALIEXPRESS_TIMEOUT_SECONDS=10
ALIEXPRESS_MAX_RETRIES=2
ALIEXPRESS_MIN_INTERVAL_SECONDS=1.0
ALIEXPRESS_BACKOFF_BASE_SECONDS=1.0
ALIEXPRESS_BACKOFF_MAX_SECONDS=30.0
ALIEXPRESS_JITTER_MAX_SECONDS=0.5
ALIEXPRESS_MAX_RETRY_AFTER_SECONDS=60
ALIEXPRESS_MAX_CONSECUTIVE_429=3
ALIEXPRESS_LOCK_TIMEOUT_SECONDS=15


CATALOG_MAINTENANCE_BATCH_SIZE=5

# Google Search Console source: WINDSOR (current) or GOOGLE_OFFICIAL (free).
# Provider changes are explicit, never automatic if an authorization fails.
# Both modes use only the fixed, authorized domain property.
GOOGLE_SEARCH_CONSOLE_PROVIDER=WINDSOR
# GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:lowcost-europa.eu

# Windsor connector key (existing source; optional after official OAuth is ready).
WINDSOR_API_KEY=

# Official API requires a separate, owner-authorized OAuth grant with the
# webmasters.readonly scope and offline refresh access. Credentials must live
# only in the existing PRIVATE systemd environment, never in this repository.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# No Meta/Facebook Ads configuration is used by this project.

# Production defaults to requiring a verified positive EUR offer price observed
# in the last 24 hours. Use false only for explicitly approved rollback.
# DJANGO_PUBLIC_RECENT_PRICE_REQUIRED=true

# Europe-focused IP country language selection: enable only after installing
# .geoip/dbip-country-lite.mmdb inside this project and checking Nginx X-Real-IP.
DJANGO_GEO_LANGUAGE_ENABLED=false

# Current canonical host (Dynadot DNS/TLS already in production).
# Keep staging/production authorization values in the PRIVATE server env.
# DJANGO_ALLOWED_HOSTS=lowcost-europa.eu,www.lowcost-europa.eu
# DJANGO_CSRF_TRUSTED_ORIGINS=https://lowcost-europa.eu,https://www.lowcost-europa.eu
# DJANGO_PUBLIC_SITE_URL=https://www.lowcost-europa.eu
# DJANGO_PUBLIC_INDEXING_ENABLED=false

# Public-facing business address: geral@lowcost-europa.eu.
# Forwarding destination is private in Dynadot and MUST NOT be committed here.
# Set PUBLIC_INDEXING_ENABLED only on the canonical production host after the
# published HTTPS, search, commercial and owner-identity gates are verified.
